<brls:AppletFrame
        title="Catalog"
        iconInterpolation="linear"
        headerHidden="false"
        footerHidden="false">
    <brls:Box
            axis="column"
            width="100%"
            height="100%">

        <brls:Box
                paddingLeft="20"
                paddingRight="20"
                paddingTop="10"
                paddingBottom="10">
            <brls:Label
                    id="addon/catalog/header"
                    fontSize="22"
                    grow="1" />
        </brls:Box>

        <RecyclingGrid
                id="addon/catalog/grid"
                paddingLeft="20"
                paddingRight="20"
                grow="1"
                spanCount="@style/tsvitch/grid/span/4"
                itemHeight="280"
                wireframe="false"
                preFetchLine="2" />

    </brls:Box>
</brls:AppletFrame>
